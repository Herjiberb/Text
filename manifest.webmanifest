{"name":"Text","short_name":"Text","description":"Fast offline text editor for huge files","start_url":"./","scope":"./","id":"./","display":"standalone","display_override":["window-controls-overlay","standalone"],"background_color":"#1b1b1b","theme_color":"#1b1b1b","categories":["productivity","utilities"],"icons":[{"src":"icon-192.png","sizes":"192x192","type":"image/png","purpose":"any maskable"},{"src":"icon-512.png","sizes":"512x512","type":"image/png","purpose":"any maskable"}],"shortcuts":[{"name":"New file","short_name":"New","description":"Start a new empty file","url":"./?a=new","icons":[{"src":"icon-192.png","sizes":"192x192"}]},{"name":"Open file\u2026","short_name":"Open","description":"Choose files to open","url":"./?a=open","icons":[{"src":"icon-192.png","sizes":"192x192"}]},{"name":"Find in current file","short_name":"Find","description":"Jump to the find box","url":"./?a=find","icons":[{"src":"icon-192.png","sizes":"192x192"}]},{"name":"Toggle word wrap","short_name":"Wrap","description":"Turn line wrapping on or off","url":"./?a=wrap","icons":[{"src":"icon-192.png","sizes":"192x192"}]},{"name":"Settings","short_name":"Settings","description":"Open Text settings","url":"./?a=settings","icons":[{"src":"icon-192.png","sizes":"192x192"}]}],"file_handlers":[{"action":"./","accept":{"text/plain":[".txt",".log",".text",".conf",".cfg",".ini",".env",".toml",".properties",".gitignore",".sh",".bash",".py",".rb",".c",".h",".cpp",".java",".go",".rs",".php",".sql",".ts",".tsx",".jsx",".lua",".bat"],"text/html":[".html",".htm",".xhtml"],"text/css":[".css",".scss",".less"],"text/javascript":[".js",".mjs",".cjs"],"application/json":[".json",".jsonc",".map",".webmanifest",".geojson"],"text/markdown":[".md",".markdown"],"application/xml":[".xml",".svg",".rss",".plist"],"text/csv":[".csv",".tsv"],"application/x-yaml":[".yml",".yaml"]}}],"launch_handler":{"client_mode":"focus-existing"}}
